{
  "name": "bookmark-insight",
  "version": "2.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A powerful bookmark manager Chrome extension",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify",
    "build:js": "rollup -c",
    "build": "npm run build:css && npm run build:js && npm run clean:maps",
    "clean:maps": "rm -f public/*.map background.js.map analysis-worker.js.map",
    "dist": "npm run build && rm -rf dist && mkdir -p dist && cp -r public icons manifest.json dashboard.html sidepanel.html background.js analysis-worker.js dist/ && echo 'Dist size:' && du -sh dist",
    "dev:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --watch",
    "dev": "npm run build:css && rollup -c -w",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{js,svelte,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,svelte,css}\"",
    "test": "vitest run",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-terser": "^0.4.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "postcss": "^8.4.32",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "rollup": "^3.25.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-svelte": "^7.1.0",
    "svelte": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "chart.js": "^4.3.0",
    "dexie": "^4.2.1",
    "flexsearch": "^0.8.212"
  }
}
